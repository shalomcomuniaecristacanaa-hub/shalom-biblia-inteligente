{
  "name": "shalom-biblia-inteligente",
  "version": "0.2.0",
  "private": true,
  "description": "Plugin SPresenter: análise temática e seleção segura de fundos bíblicos",
  "scripts": {
    "build": "esbuild src/code.ts --bundle --platform=browser --format=iife --outfile=dist/code.js --external:@spresenter/plugin-sdk/code",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@spresenter/plugin-sdk": "0.3.50"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "adm-zip": "^0.5.16"
  }
}
